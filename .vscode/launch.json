{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "NoteHub - Backend",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/server",
            "program": "${workspaceFolder}/server/server.js",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "NoteHub - Frontend",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/client"
        }
    ],
    "compounds": [
        {
            "name": "NoteHub - Full Project",
            "configurations": [
                "NoteHub - Backend",
                "NoteHub - Frontend"
            ],
            "stopAll": true
        }
    ]
}